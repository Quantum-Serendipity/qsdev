{ pkgs, lib, config, options, ... }:
{
  # Local customizations (not managed by qsdev) go in devenv.local.nix, which
  # devenv loads on its own; importing it here too would apply it twice.
{{- if .Overlays }}

  # Nixpkgs overlays
  overlays = [
{{- range .Overlays }}
    (import {{ . }})
{{- end }}
  ];
{{- end }}

  # Base packages
  packages = {{ nixPkgList .Packages }}{{ range .PackageExprs }} ++ [ {{ . }} ]{{ end }};
  env = {
{{- range $key, $val := .EnvVars}}
    {{ nixIdent $key }} = {{ nixString $val }};
{{- end}}
  };

  # Credential-bearing variables stripped from the shell, on top of devenv's
  # own default list (a plain assignment would replace those defaults).
  unsetEnvVars = options.unsetEnvVars.default ++ {{ nixStringList .UnsetEnvVars }};

  # Disable .env file loading for security
  dotenv.enable = false;
{{- if .CachixPull }}

  # Project binary cache (infrastructure.nix_cache). The Nix daemon uses it
  # only when the system trusts it: see docs/nix-conf-hardening.md.
  cachix.pull = {{ nixStringList .CachixPull }};
{{- end }}
{{- range .LanguageFragments}}

  # {{ nixComment .DisplayName }}
{{ .NixFragment | trimTrailingNewline }}
{{- end}}
{{- if .Services}}

  # Services
{{- range .Services}}
  services.{{ nixIdent .NixName }} = {
    enable = true;
{{- range .ConfigLines}}
    {{ . }}
{{- end}}
  };
{{- end}}
{{- end}}
{{- if .ServiceScripts}}

  # Service convenience scripts
{{- range .ServiceScripts}}
  scripts.{{ nixIdent .Name }}.exec = {{ nixString .Exec }};
{{- end}}
{{- end}}
{{- if .TaskScripts }}

  # Development tasks (generated by qsdev). Scripts land on PATH, so they also
  # work in direnv-activated shells, and each fails on its first failing command.
{{- range .TaskScripts }}
  scripts.{{ nixString .Name }} = {
    description = {{ nixString .Description }};
    exec = ''
{{ nixMultiline .Exec | indent 6 }}
    '';
  };
{{- end }}
{{- end }}
{{- if .GitHooksEnabled}}

  # Git hooks — managed by prek (devenv 1.11+ default hook runner).
  # Hook tiers follow the security level: security hooks run at every level,
  # language-aware formatters and linters from "enhanced" up (catalog hook_tiers).
  git-hooks.hooks = {
    # Always-on hooks (less any tiered above the security level)
{{- range .SecurityHooks}}
    {{ nixHookID . }}.enable = true;
{{- end}}
    # Enhanced hooks (language-aware, from ecosystem modules)
{{- range .BuiltInHooks}}
{{- if or .TypesOr .ExcludeTypes .Excludes .Settings }}
    {{ nixHookID .ID }} = {
      enable = true;
{{- if .TypesOr }}
      types_or = {{ nixStringList .TypesOr }};
{{- end }}
{{- if .ExcludeTypes }}
      exclude_types = {{ nixStringList .ExcludeTypes }};
{{- end }}
{{- if .Excludes }}
      excludes = {{ nixStringList .Excludes }};
{{- end }}
{{- range .Settings }}
      settings.{{ nixIdent .Key }} = {{ nixString .Value }};
{{- end }}
    };
{{- else }}
    {{ nixHookID .ID }}.enable = true;
{{- end }}
{{- end}}
{{- range .HookOverrides}}
{{- if .TypesOr}}
    {{ nixHookID .ID }}.types_or = {{ nixStringList .TypesOr }};
{{- end}}
{{- if .ExcludeTypes}}
    {{ nixHookID .ID }}.exclude_types = {{ nixStringList .ExcludeTypes }};
{{- end}}
{{- end}}
    # Specialized hooks (custom definitions)
    # Each package is set at priority 999: a devenv language module that sets
    # the same hook's package (100, or 500 via mkOverrideDefault) wins with its
    # pinned toolchain, and git-hooks.nix's mkDefault (1000) built-in default
    # is never evaluated. An equal priority throws "defined multiple times".
{{- range .CustomHooks}}
    {{ nixHookID .ID }} = {
      enable = true;
      name = {{ nixString .Name }};
      description = {{ nixString .Description }};
{{- if .RawEntry }}
{{- if .NeedsToString }}
      entry = toString ({{ .Entry }});
{{- else }}
      entry = {{ .Entry }};
{{- end }}
{{- else }}
      entry = {{ nixString .Entry }};
{{- end }}
      language = {{ nixString .Language }};
{{- if .PackageExpr }}
      package = lib.mkOverride 999 {{ .PackageExpr }};
{{- end }}
{{- if .Types}}
      types = {{ nixStringList .Types }};
{{- end}}
{{- if .TypesOr}}
      types_or = {{ nixStringList .TypesOr }};
{{- end}}
{{- if .ExcludeTypes}}
      exclude_types = {{ nixStringList .ExcludeTypes }};
{{- end}}
{{- if .Stages}}
      stages = {{ nixStringList .Stages }};
{{- end}}
{{- if .Files}}
      files = {{ nixString .Files }};
{{- end}}
{{- if .Excludes}}
      excludes = {{ nixStringList .Excludes }};
{{- end}}
      pass_filenames = {{ nixBool .PassFilenames }};
    };
{{- end}}
  };
{{- end}}

  enterShell = ''
{{- if .NeedsNativeLibPath }}
    # Native library path for uv-installed Python packages with C extensions (NixOS).
    export LD_LIBRARY_PATH="${pkgs.stdenv.cc.cc.lib}/lib''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
{{- end }}
{{ nixMultiline .EnterShell | indent 4 }}
  '';

  enterTest = ''
{{ nixMultiline .EnterTest | indent 4 }}
  '';
}
