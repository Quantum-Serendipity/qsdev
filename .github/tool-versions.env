# Versions of the CI and release tools that no Dependabot ecosystem covers.
# This file is their only source: each job that uses one appends this file's
# KEY=value lines to $GITHUB_ENV and references ${{ env.KEY }}, or runs a
# .github/scripts/ script that reads the file, so no workflow carries a
# literal version (TestToolVersionsSingleSource).
#
# Bumped by .github/workflows/tool-pins.yml (scripts/bump-tool-pins.sh), which
# takes a newer exact release only once it is at least 3 days old, the
# catalog's baseline age gate. Each KEY line needs a "# source:" line directly
# above it naming where the updater looks:
#   github <owner>/<repo>  GitHub releases (tools the workflows download
#                          as release binaries)
#   goproxy <module>       versions on proxy.golang.org (tools built with
#                          go install)
#   nix-release <owner>/<repo>
#                          Nix's X.Y.Z tags on GitHub, taken once the
#                          binary tarballs are published on releases.nixos.org
#                          (aged from that publication)
#   nix-sha256 <system>    the SHA-256 of nix-<NIX_VERSION>-<system>.tar.xz,
#                          refreshed from the release's published .sha256
#                          whenever NIX_VERSION moves; must follow NIX_VERSION

# source: github goreleaser/goreleaser
GORELEASER_VERSION=v2.18.2

# source: github golangci/golangci-lint
GOLANGCI_LINT_VERSION=v2.12.2

# source: goproxy gotest.tools/gotestsum
GOTESTSUM_VERSION=v1.13.0

# source: goproxy golang.org/x/vuln
GOVULNCHECK_VERSION=v1.3.0

# The official Nix installer tarball .github/scripts/install-nix.sh verifies
# against these digests before extracting or running anything.
# source: nix-release NixOS/nix
NIX_VERSION=2.34.8

# source: nix-sha256 x86_64-linux
NIX_SHA256_X86_64_LINUX=2c2e146b80834fe0ca201b51deeb939405b4f18e8d2071bf80b10f8123c50464

# source: nix-sha256 aarch64-linux
NIX_SHA256_AARCH64_LINUX=b4e565fe4db5c352547b8146488cab81db06be89301a4c67b081c76f1e457760

# source: nix-sha256 aarch64-darwin
NIX_SHA256_AARCH64_DARWIN=ae3b2b1a74b956110d14dd813bee80ea46626a51ddce28d142e0805379a34acf

# source: nix-sha256 x86_64-darwin
NIX_SHA256_X86_64_DARWIN=14d3af62d1c1755da7e048519a73baeab3e856cba766e53fca5ceec4e6fe67e2
