{
  "mcpServers": {
    "agent-postmortem": {
      "args": [
        "mcp",
        "serve",
        "--module",
        "agent-postmortem"
      ],
      "command": "qsdev"
    },
    "context7": {
      "args": [
        "@upstash/context7-mcp@4.1.1"
      ],
      "command": "npx"
    },
    "github": {
      "args": [
        "stdio"
      ],
      "command": "github-mcp-server",
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "local-docs-devdocs": {
      "args": [
        "@madhan-g-p/devdocs-mcp-server@1.0.1"
      ],
      "command": "npx",
      "env": {
        "DEVDOCS_DATA_PATH": "${HOME}/.qsdev/docs/devdocs",
        "MCP_DB_PATH": "${HOME}/.qsdev/docs/mcp.db"
      }
    },
    "semble": {
      "args": [
        "--from",
        "semble[mcp]==0.6.0",
        "semble"
      ],
      "command": "uvx"
    },
    "socket": {
      "type": "http",
      "url": "https://mcp.socket.dev/"
    },
    "version-sentinel": {
      "args": [
        "mcp",
        "serve",
        "--module",
        "version-sentinel"
      ],
      "command": "qsdev"
    }
  }
}
