{ pkgs, lib, config, options, ... }:
{
  # Local customizations (not managed by qsdev) go in devenv.local.nix, which
  # devenv loads on its own; importing it here too would apply it twice.
{{- if .Overlays }}

  # Nixpkgs overlays
  overlays = [
{{- range .Overlays }}
    (import {{ . }})
{{- end }}
  ];
{{- end }}

  # Base packages
  packages = {{ nixPkgList .Packages }}{{ range .PackageExprs }} ++ [ {{ . }} ]{{ end }};
  env = {
{{- range $key, $val := .EnvVars}}
    {{ $key }} = {{ nixString $val }};
{{- end}}
  };

  # Credential-bearing variables stripped from the shell, on top of devenv's
  # own default list (a plain assignment would replace those defaults).
  unsetEnvVars = options.unsetEnvVars.default ++ {{ nixStringList .UnsetEnvVars }};

  # Disable .env file loading for security
  dotenv.enable = false;
{{- range .LanguageFragments}}

  # {{ .DisplayName }}
{{ .NixFragment | trimTrailingNewline }}
{{- end}}
{{- if .Services}}

  # Services
{{- range .Services}}
  services.{{ .NixName }} = {
    enable = true;
{{- range .ConfigLines}}
    {{ . }}
{{- end}}
  };
{{- end}}
{{- end}}
{{- if .ServiceScripts}}

  # Service convenience scripts
{{- range .ServiceScripts}}
  scripts.{{ .Name }}.exec = {{ nixString .Exec }};
{{- end}}
{{- end}}
{{- if .TaskScripts }}

  # Development tasks (generated by qsdev). Scripts land on PATH, so they also
  # work in direnv-activated shells, and each fails on its first failing command.
{{- range .TaskScripts }}
  scripts.{{ nixString .Name }} = {
    description = {{ nixString .Description }};
    exec = ''
{{ nixMultiline .Exec | indent 6 }}
    '';
  };
{{- end }}
{{- end }}
{{- if .GitHooksEnabled}}

  # Git hooks — managed by prek (devenv 1.11+ default hook runner).
  # Tiers: baseline (always-on), enhanced (language-aware), specialized (custom)
  git-hooks.hooks = {
    # Baseline security hooks (always enabled)
{{- range .SecurityHooks}}
    {{ . }}.enable = true;
{{- end}}
    # Enhanced hooks (language-aware, from ecosystem modules)
{{- range .BuiltInHooks}}
{{- if or .TypesOr .ExcludeTypes .Excludes .Settings }}
    {{ .ID }} = {
      enable = true;
{{- if .TypesOr }}
      types_or = {{ nixStringList .TypesOr }};
{{- end }}
{{- if .ExcludeTypes }}
      exclude_types = {{ nixStringList .ExcludeTypes }};
{{- end }}
{{- if .Excludes }}
      excludes = {{ nixStringList .Excludes }};
{{- end }}
{{- range .Settings }}
      settings.{{ .Key }} = {{ nixString .Value }};
{{- end }}
    };
{{- else }}
    {{ .ID }}.enable = true;
{{- end }}
{{- end}}
{{- range .HookOverrides}}
{{- if .TypesOr}}
    {{ .ID }}.types_or = {{ nixStringList .TypesOr }};
{{- end}}
{{- if .ExcludeTypes}}
    {{ .ID }}.exclude_types = {{ nixStringList .ExcludeTypes }};
{{- end}}
{{- end}}
    # Specialized hooks (custom definitions)
{{- range .CustomHooks}}
    {{ .ID }} = {
      enable = true;
      name = {{ nixString .Name }};
      description = {{ nixString .Description }};
{{- if .RawEntry }}
{{- if .NeedsToString }}
      entry = toString ({{ .Entry }});
{{- else }}
      entry = {{ .Entry }};
{{- end }}
{{- else }}
      entry = {{ nixString .Entry }};
{{- end }}
      language = {{ nixString .Language }};
{{- if .Package }}
      package = pkgs.{{ .Package }};
{{- end }}
{{- if .Types}}
      types = {{ nixStringList .Types }};
{{- end}}
{{- if .TypesOr}}
      types_or = {{ nixStringList .TypesOr }};
{{- end}}
{{- if .ExcludeTypes}}
      exclude_types = {{ nixStringList .ExcludeTypes }};
{{- end}}
{{- if .Stages}}
      stages = {{ nixStringList .Stages }};
{{- end}}
{{- if .Files}}
      files = {{ nixString .Files }};
{{- end}}
{{- if .Excludes}}
      excludes = {{ nixStringList .Excludes }};
{{- end}}
      pass_filenames = {{ nixBool .PassFilenames }};
    };
{{- end}}
  };
{{- end}}

  enterShell = ''
{{- if .NeedsNativeLibPath }}
    # Native library path for uv-installed Python packages with C extensions (NixOS).
    export LD_LIBRARY_PATH="${pkgs.stdenv.cc.cc.lib}/lib''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
{{- end }}
{{ nixMultiline .EnterShell | indent 4 }}
  '';

  enterTest = ''
{{ nixMultiline .EnterTest | indent 4 }}
  '';
}
