{ pkgs, lib, options, ... }:
{
  # Local customizations (not managed by qsdev) go in devenv.local.nix, which
  # devenv loads on its own; importing it here too would apply it twice.

  # Nixpkgs overlays
  overlays = [
    (import ./nix/go-overlay.nix)
  ];

  # Base packages
  packages = [ pkgs.git pkgs.jq pkgs.curl pkgs.coreutils pkgs.go-tools pkgs.govulncheck pkgs.gopls pkgs.golangci-lint pkgs.delve pkgs.goreleaser pkgs.gitleaks pkgs.github-mcp-server pkgs.uv ] ++ [ (pkgs.writeShellScriptBin "semgrep" "exec -a osemgrep ''${pkgs.semgrep-core}/bin/semgrep-core --experimental \"$@\"") ];
  env = {
    DEVENV_SECURITY_HARDENED = "true";
    QSDEV_ECOSYSTEMS = "go";
    QSDEV_LSP_ENFORCEMENT = "block";
    QSDEV_PROJECT_NAME = "qsdev";
    QSDEV_SECURITY_PROFILE = "enhanced";
    QSDEV_TOOL_COUNT = "27";
    QSDEV_VERSION = "dev";

    # Verify all public modules against the Go checksum database
    GOSUMDB = "sum.golang.org";
  };

  # Credential-bearing variables stripped from the shell, on top of devenv's
  # own default list (a plain assignment would replace those defaults).
  unsetEnvVars = options.unsetEnvVars.default ++ [ "AWS_ACCESS_KEY_ID" "AWS_SECRET_ACCESS_KEY" "AWS_SESSION_TOKEN" "AWS_SECURITY_TOKEN" "GITHUB_TOKEN" "GH_TOKEN" "GITHUB_PAT" "GITLAB_TOKEN" "GL_TOKEN" "GOOGLE_APPLICATION_CREDENTIALS" "AZURE_CLIENT_ID" "AZURE_CLIENT_SECRET" "NPM_TOKEN" "PYPI_TOKEN" "DOCKER_PASSWORD" "DOCKER_AUTH_CONFIG" "CACHIX_AUTH_TOKEN" "DATABASE_URL" "DATABASE_PASSWORD" "PGPASSWORD" "MYSQL_PWD" "REDIS_PASSWORD" "VAULT_TOKEN" "SENTRY_DSN" "STRIPE_SECRET_KEY" "SENDGRID_API_KEY" "SLACK_TOKEN" "SLACK_WEBHOOK_URL" "API_KEY" "API_SECRET" "SECRET_KEY" "PRIVATE_KEY" "ENCRYPTION_KEY" ];

  # Disable .env file loading for security
  dotenv.enable = false;

  languages = {
    # Go
    go = {
      enable = true;
      version = lib.mkIf (!(lib.versionAtLeast pkgs.go.version "1.26.9")) "1.26.9";

      # LSP servers (qsdev-managed)
      lsp.enable = true;
    };

    nix = {
      # Analyzer config lives in .claude/skills/qsdev-lsp/.lsp.json.
      enable = true;
      lsp.enable = true;
    };
  };

  scripts = {
    # Development tasks (generated by qsdev). Scripts land on PATH, so they also
    # work in direnv-activated shells, and each fails on its first failing command.
    "qsdev-build" = {
      description = "Build all projects";
      exec = ''
        set -euo pipefail
        go build ./...
      '';
    };
    "qsdev-test" = {
      description = "Run all test suites";
      exec = ''
        set -euo pipefail
        qsdev-build
        go test ./...
      '';
    };
    "qsdev-lint" = {
      description = "Run all linters";
      exec = ''
        set -euo pipefail
        go vet ./...
        golangci-lint run
      '';
    };
    "qsdev-format" = {
      description = "Format all source code";
      exec = ''
        set -euo pipefail
        gofmt -l .
      '';
    };
    "qsdev-security-scan" = {
      description = "Run security scanners";
      exec = ''
        set -euo pipefail
        semgrep --config p/golang --config p/owasp-top-ten $(if [ -d .semgrep ]; then echo --config .semgrep; fi) --metrics=off --error .
        gitleaks detect --no-banner
      '';
    };
  };

  # Git hooks — managed by prek (devenv 1.11+ default hook runner).
  # Hook tiers follow the security level: security hooks run at every level,
  # language-aware formatters and linters from "enhanced" up (catalog hook_tiers).
  git-hooks.hooks = {
    # Analyzer config lives in .claude/skills/qsdev-lsp/.lsp.json.
    # Branch Naming Convention
    branch-naming = {
      enable = true;
      name = "Branch naming convention";
      description = "Validates the branch name against git.branch_pattern";
      entry = "${pkgs.writeShellScript "branch-naming" ''
        branch=$(git rev-parse --abbrev-ref HEAD)
        pattern='^[A-Za-z0-9][A-Za-z0-9._/@+-]*$'
        case "$branch" in
          HEAD|main|master|develop) exit 0 ;;
        esac
        if ! printf '%s\n' "$branch" | LC_ALL=C grep -qE -e "$pattern"; then
          echo "ERROR: Branch name '$branch' does not match the branch naming pattern."
          echo "Expected a name matching: $pattern"
          echo "Rename the branch (git branch -m <new-name>), or set git.branch_pattern"
          echo "in .qsdev.yaml and run 'qsdev init --update'."
          exit 1
        fi
      ''}";
      language = "system";
      stages = [ "pre-push" ];
      pass_filenames = false;
      always_run = true;
    };
    # Always-on hooks (less any tiered above the security level)
    ripsecrets = {
      enable = true;
      excludes = [ "(^|/)vendor/" ];
    };
    check-added-large-files.enable = true;
    no-commit-to-branch.enable = true;
    check-merge-conflicts.enable = true;
    shellcheck = {
      enable = true;
      exclude_types = [ "zsh" ];
      excludes = [ "(^|/)vendor/" ];
    };
    statix.enable = true;
    # Enhanced hooks (language-aware, from ecosystem modules)
    gofmt = {
      enable = true;
      excludes = [ "(^|/)(testdata|vendor)/" "(^|/)[._][^/]*/" ];
    };
    govet = {
      enable = true;
      excludes = [ "(^|/)(testdata|vendor)/" "(^|/)[._][^/]*/" ];
    };
    # Specialized hooks (custom definitions)
    # Each package is set at priority 999: a devenv language module that sets
    # the same hook's package (100, or 500 via mkOverrideDefault) wins with its
    # pinned toolchain, and git-hooks.nix's mkDefault (1000) built-in default
    # is never evaluated. An equal priority throws "defined multiple times".
    staticcheck = {
      enable = true;
      name = "staticcheck";
      description = "Run staticcheck for advanced static analysis";
      entry = "${pkgs.go-tools}/bin/staticcheck ./...";
      language = "system";
      package = lib.mkOverride 999 pkgs.go-tools;
      types = [ "go" ];
      stages = [ "pre-commit" ];
      pass_filenames = false;
    };
    govulncheck = {
      enable = true;
      name = "govulncheck";
      description = "Check for known vulnerabilities in Go dependencies";
      entry = "${pkgs.govulncheck}/bin/govulncheck ./...";
      language = "system";
      package = lib.mkOverride 999 pkgs.govulncheck;
      types = [ "go" ];
      stages = [ "pre-commit" ];
      pass_filenames = false;
    };
    lock-file-audit = {
      enable = true;
      name = "Lock file change audit";
      description = "Flag lock file changes for review — lock files redirect package sources";
      entry = toString (pkgs.writeShellScript "lock-audit" ''
        for f in "$@"; do
          echo "WARNING: $f has been modified."
          echo "  Lock file changes redirect package sources."
          echo "  Verify the diff carefully during code review."
          case "$f" in
            devenv.lock|flake.lock|*/devenv.lock|*/flake.lock)
              echo "  Run 'nix flake metadata' to inspect resolved inputs."
              ;;
            *)
              echo "  Check that every resolved/source URL points at your registry over https"
              echo "  and that each package still carries an integrity hash."
              ;;
          esac
        done
      '');
      language = "system";
      stages = [ "pre-commit" ];
      files = "(devenv|flake)\\.lock$|(^|/)(go\\.sum)$";
      pass_filenames = true;
    };
    nix-secrets-check = {
      enable = true;
      name = "Nix file secrets check";
      description = "Detect hardcoded secrets and credential patterns in .nix files";
      entry = toString (let
          envPattern = "env\\.\\w*(SECRET|TOKEN|PASSWORD|KEY|CREDENTIAL|API_KEY)\\w*\\s*=";
          credPattern = "(" + "sk_l" + "ive_" + "|" + "sk_t" + "est_" + "|" + "gh" + "p_" + "|" + "gh" + "o_" + "|" + "glp" + "at-" + "|" + "AKIA[A-Z" + "0-9]{16}" + ")";
        in
        pkgs.writeShellScript "nix-secrets-check" ''
          ret=0
          for f in "$@"; do
            if ${pkgs.gnugrep}/bin/grep -nP -e ${lib.escapeShellArg envPattern} "$f" 2>/dev/null; then
              echo "ERROR: $f appears to set a secret via env.*"
              ret=1
            fi
            if ${pkgs.gnugrep}/bin/grep -nP -e ${lib.escapeShellArg credPattern} "$f" 2>/dev/null; then
              echo "ERROR: $f appears to contain a hardcoded credential"
              ret=1
            fi
          done
          exit $ret
        '');
      language = "system";
      stages = [ "pre-commit" ];
      files = "\\.nix$";
      pass_filenames = true;
    };
  };

  enterShell = ''
    # Native library path for uv-installed Python packages with C extensions (NixOS).
    export LD_LIBRARY_PATH="${pkgs.stdenv.cc.cc.lib}/lib''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    echo ""
    echo "=== Security-Hardened Development Environment ==="

    # Verify git hooks are installed
    hooks_state=unknown
    if command -v git >/dev/null 2>&1 && hooks_dir="$(git rev-parse --git-path hooks 2>/dev/null)"; then
      if [ -f "$hooks_dir/pre-commit" ]; then
        hooks_state=active
      else
        hooks_state=missing
      fi
    fi
    unset hooks_dir
    case "$hooks_state" in
      active) echo "  Pre-commit hooks: active" ;;
      missing)
        echo "  WARNING: Pre-commit hooks not installed."
        echo "           Run 'devenv shell' to install them."
        ;;
      *) echo "  Pre-commit hooks: unknown (not a git repository)" ;;
    esac
    unset hooks_state

    # Verify clean environment is working (spot-check)
    if [ -n "''${AWS_SECRET_ACCESS_KEY:-}" ]; then
      echo "  WARNING: AWS_SECRET_ACCESS_KEY is set in environment!"
      echo "           This should have been stripped by clean mode."
      echo "           Check devenv.yaml clean.keep settings."
    fi
    if [ -n "''${VAULT_TOKEN:-}" ]; then
      echo "  WARNING: VAULT_TOKEN is set in environment!"
      echo "           This should have been stripped by clean mode."
      echo "           Check devenv.yaml clean.keep settings."
    fi
    if [ -n "''${DATABASE_PASSWORD:-}" ]; then
      echo "  WARNING: DATABASE_PASSWORD is set in environment!"
      echo "           This should have been stripped by clean mode."
      echo "           Check devenv.yaml clean.keep settings."
    fi

    # Verify ripsecrets is available
    if command -v ripsecrets >/dev/null 2>&1; then
      echo "  Secret scanning: available (ripsecrets)"
    else
      echo "  WARNING: ripsecrets not found in PATH"
    fi

    # MCP credential provisioning — re-inject after clean mode stripping, limited
    # to the variables .mcp.json references as placeholders.
    mcp_refs() {
      [ -f "$PWD/.mcp.json" ] && grep -Eq "[$][{]$1(:-[^}]*)?[}]" "$PWD/.mcp.json"
    }

    # GITHUB_TOKEN: sourced from gh CLI keyring (never touches disk).
    if mcp_refs GITHUB_TOKEN && command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
      export GITHUB_TOKEN="$(gh auth token 2>/dev/null)"
    fi

    # Project-scoped MCP secrets (.qsdev/ is gitignored), read as KEY=VALUE lines.
    if [ -f "$PWD/.qsdev/mcp-secrets.env" ]; then
      while IFS= read -r line || [ -n "$line" ]; do
        line="''${line%$'\r'}"
        case "$line" in ""|"#"*) continue ;; esac
        line="''${line#export }"
        key="''${line%%=*}"
        val="''${line#*=}"
        if [ "$key" = "$line" ] || ! [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
          echo "  WARNING: ignoring malformed line in .qsdev/mcp-secrets.env"
          continue
        fi
        if ! mcp_refs "$key"; then
          echo "  WARNING: ignoring $key from .qsdev/mcp-secrets.env (not referenced by .mcp.json)"
          continue
        fi
        case "$key" in
          LD_*|DYLD_*|BASH_ENV|ENV|BASH_FUNC_*|PROMPT_COMMAND)
            echo "  WARNING: ignoring $key from .qsdev/mcp-secrets.env (affects program loading)"
            continue ;;
        esac
        if [ -n "''${!key+x}" ]; then
          echo "  WARNING: ignoring $key from .qsdev/mcp-secrets.env (already set)"
          continue
        fi
        case "$val" in
          \"*\"|\'*\') val="''${val:1:''${#val}-2}" ;;
        esac
        export "$key=$val"
      done < "$PWD/.qsdev/mcp-secrets.env"
      unset line key val
    fi
    unset -f mcp_refs

    echo "==================================================="
    echo ""
    echo "  ''${QSDEV_PROJECT_NAME:-unknown} | security: ''${QSDEV_SECURITY_PROFILE:-standard} | tools: ''${QSDEV_TOOL_COUNT:-0}"
    echo ""

    # Shell completions for qsdev
    if command -v qsdev >/dev/null 2>&1; then
      if [ -n "''${ZSH_VERSION:-}" ]; then
        eval "$(qsdev completion zsh)"
      elif [ -n "''${BASH_VERSION:-}" ]; then
        eval "$(qsdev completion bash)"
      fi
    fi
  '';

  enterTest = ''
    echo "=== Security Validation ==="

    # 1. Verify pre-commit hooks are installed (worktree- and hooksPath-aware)
    hooks_state=unknown
    if command -v git >/dev/null 2>&1 && hooks_dir="$(git rev-parse --git-path hooks 2>/dev/null)"; then
      if [ -f "$hooks_dir/pre-commit" ]; then
        hooks_state=active
      else
        hooks_state=missing
      fi
    fi
    unset hooks_dir
    case "$hooks_state" in
      active) echo "PASS: pre-commit hooks installed" ;;
      missing)
        echo "FAIL: pre-commit hooks not installed"
        exit 1
        ;;
      *) echo "SKIP: not a git repository; pre-commit hook check skipped" ;;
    esac

    # 2. Verify ambient credential leakage is prevented.
    # Variables .mcp.json references (e.g. GITHUB_TOKEN) are re-injected on purpose.
    for var in AWS_SECRET_ACCESS_KEY VAULT_TOKEN DATABASE_PASSWORD; do
      if printenv "$var" >/dev/null 2>&1; then
        echo "FAIL: $var is set in the environment"
        exit 1
      fi
    done
    echo "PASS: no ambient credential leakage"

    # 3. Verify ripsecrets finds no issues in tracked files
    if command -v ripsecrets >/dev/null 2>&1; then
      if ripsecrets --strict-ignore . 2>/dev/null; then
        echo "PASS: no secrets detected in codebase"
      else
        echo "FAIL: ripsecrets found potential secrets"
        exit 1
      fi
    fi

    # 4. Verify DEVENV_SECURITY_HARDENED flag is set
    test "''${DEVENV_SECURITY_HARDENED:-}" = "true" || {
      echo "FAIL: DEVENV_SECURITY_HARDENED not set (security config may be overridden)"
      exit 1
    }
    echo "PASS: security-hardened flag present"

    echo "=== All security checks passed ==="
  '';
}
